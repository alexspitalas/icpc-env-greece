#!/bin/sh
# Wrapper around DOMjudge `submit` so `-P` / `--print` routes to a configured
# external or local print setup (`ipp`, `cups`, `http`, `local`) when PRINT_MODE != domjudge.
ICPC_DIR="${ICPC_DIR:-/icpc}"
PRINT_MODE="$(tr -d '[:space:]' < "$ICPC_DIR/PRINT_MODE" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
PRINT_MODE="${PRINT_MODE:-domjudge}"

if [ "$PRINT_MODE" != "domjudge" ]; then
    for arg in "$@"; do
        case "$arg" in
            --)
                break
                ;;
            -P|--print)
                exec /usr/local/bin/djprint "$@"
                ;;
        esac
    done
fi

exec /usr/local/bin/domjudge-submit "$@"
