#!/usr/bin/env python3
"""Unified contest print command supporting DOMjudge, IPP/CUPS, and HTTP print servers."""

import base64
import os
from pathlib import Path
import socket
import subprocess
import sys


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def resolve_team_name(icpc_dir: Path) -> str:
    for candidate in (
        read_text(icpc_dir / "PRINT_TEAM"),
        read_text(icpc_dir / "TEAMNAME"),
        read_text(icpc_dir / "TEAM"),
    ):
        if candidate and candidate not in ("demo team", "default team") and not candidate.startswith("000 - demo team"):
            return candidate
    return socket.gethostname()


def http_print(icpc_dir: Path, files: list[str]) -> int:
    import requests

    url = read_text(icpc_dir / "PRINT_SERVER_URL")
    if url and "://" not in url:
        url = f"http://{url}"
    if not url:
        ip = read_text(icpc_dir / "PRINT_SERVER_IP")
        if not ip:
            print("Error: print_mode is 'http' but no PRINT_SERVER_URL or PRINT_SERVER_IP is set.", file=sys.stderr)
            return 1
        url = ip if "://" in ip else f"http://{ip}/print"

    team = resolve_team_name(icpc_dir)
    rc = 0
    for filepath in files:
        p = Path(filepath)
        if not p.is_file():
            print(f"Error: Cannot find file '{filepath}'.", file=sys.stderr)
            rc = 1
            continue
        raw = p.read_bytes()
        data = {
            "team": team,
            "filename": p.name,
            "original_name": filepath,
            "file_contents": base64.b64encode(raw).decode("ascii"),
        }
        try:
            resp = requests.post(
                url,
                data=data,
                files={"file": (p.name, raw)},
                timeout=15,
            )
            if resp.status_code >= 300:
                print(f"Print server error for '{filepath}' (HTTP {resp.status_code}): {resp.text}", file=sys.stderr)
                rc = 1
            else:
                print(f"Sent '{filepath}' to print server ({team}).")
        except requests.exceptions.RequestException as exc:
            print(f"Failed to send '{filepath}' to print server ({url}): {exc}", file=sys.stderr)
            rc = 1
    return rc


def strip_submit_flags(raw_args: list[str]) -> list[str]:
    """Strip DOMjudge `submit`-specific flags if forwarded via `submit -P`."""
    forwarded: list[str] = []
    skip_bool = {"-P", "--print", "-y", "--assume-yes", "-q", "--quiet"}
    skip_val_short = {"-p", "-l", "-c", "-e", "-u"}
    skip_val_long = {"--problem", "--language", "--contest", "--entry_point", "--url"}
    log_levels = {"DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"}

    i = 0
    after_sep = False
    while i < len(raw_args):
        arg = raw_args[i]
        if after_sep:
            forwarded.append(arg)
            i += 1
            continue
        if arg == "--":
            after_sep = True
            forwarded.append(arg)
            i += 1
            continue
        if arg in skip_bool:
            i += 1
            continue
        if arg in ("-v", "--verbose"):
            if i + 1 < len(raw_args) and raw_args[i + 1] in log_levels:
                i += 2
            else:
                i += 1
            continue
        if any(arg.startswith(f"{flag}=") for flag in (*skip_val_long, "--verbose")):
            i += 1
            continue
        if arg in skip_val_short or arg in skip_val_long:
            i += 2
            continue
        if len(arg) > 2 and arg[:2] in skip_val_short:
            i += 1
            continue
        forwarded.append(arg)
        i += 1
    return forwarded


def main():
    icpc_dir = Path(os.environ.get("ICPC_DIR", "/icpc"))
    mode = read_text(icpc_dir / "PRINT_MODE").lower() or "domjudge"

    raw_args = sys.argv[1:]
    if mode == "domjudge":
        extra = [] if ("-P" in raw_args or "--print" in raw_args) else ["--print"]
        os.execv("/usr/local/bin/domjudge-submit", ["/usr/local/bin/domjudge-submit", *extra, *raw_args])

    forwarded = strip_submit_flags(raw_args)
    non_sep = [a for a in forwarded if a != "--"]

    if not non_sep or any(a in ("-h", "--help") for a in non_sep):
        print(
            "Usage: djprint <file>...\n"
            f"Current print mode: {mode}\n"
            "Prints file(s) with the team name in the page header.",
        )
        sys.exit(0 if any(a in ("-h", "--help") for a in non_sep) else 1)

    if mode == "http":
        sys.exit(http_print(icpc_dir, non_sep))

    # ipp / cups / local -> print via pcpr (enscript with team header)
    res = subprocess.run(["/icpc/scripts/pcpr", *forwarded], check=False)
    sys.exit(res.returncode)


if __name__ == "__main__":
    main()
