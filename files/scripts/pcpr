#!/usr/bin/env python3

# usage: pcpr North.java
# usage: pcpr --output=files.ps *.java
# usage: pcpr -P printer *.cpp
# usage: pcpr --portrait -1 North.hs     [ For those with difficulty with the small print.]

import os
from pathlib import Path
import socket
import subprocess
import sys


def read_text(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def resolve_team_name() -> str:
    print_team = read_text("/icpc/PRINT_TEAM")
    if print_team:
        return print_team

    teamname = read_text("/icpc/TEAMNAME")
    if teamname and teamname not in ("demo team", "default team"):
        return teamname

    team = read_text("/icpc/TEAM")
    if team and team != "default team" and not team.startswith("000 - demo team"):
        return team

    return socket.gethostname()


def main():
    if len(sys.argv) < 2:
        print("Usage: pcpr [enscript options] <file>...", file=sys.stderr)
        sys.exit(1)

    team = resolve_team_name()

    # -MLetter generates letter size pages
    options = [
        "-MLetter",
        "-2",
        "--landscape",
        "--pretty-print",
    ]

    header = f"$n; page $% of $=; team={team}"
    res = subprocess.run(["/usr/bin/enscript", *options, f"--header={header}", *sys.argv[1:]], check=False)
    sys.exit(res.returncode)


if __name__ == "__main__":
    main()
