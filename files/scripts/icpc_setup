#!/usr/bin/env python3
from whiptail import Whiptail
from pathlib import Path
import json
import shutil
from subprocess import PIPE, Popen, run, TimeoutExpired
import sys
import signal
import os
import time
from urllib.parse import urlparse

# Trap SIGHUP because systemd sends it and we don't want it to interrupt us
signal.signal(signal.SIGHUP, signal.SIG_IGN)


def read_file(path, default):
    try:
        contents = Path(path).read_text(encoding="utf-8").strip()
        if len(contents) == 0:
            return default
        return contents
    except Exception:
        pass
    return default


def run_quiet(cmd, timeout=None):
    """Run a command without a shell, capturing output, never raising on failure/timeout."""
    try:
        return run(cmd, stdout=PIPE, stderr=PIPE, text=True, check=False, timeout=timeout)
    except (FileNotFoundError, TimeoutExpired):
        return None


def infobox(w: Whiptail, msg: str):
    """Show a non-blocking status message so the screen is never blank while work is running."""
    Popen(
        ["whiptail", "--title", w.title, "--backtitle", w.backtitle, "--infobox", msg, "8", "70"],
        stderr=PIPE,
    ).communicate()


def set_network_backtitle(w: Whiptail, online: bool):
    w.backtitle = f"Network status: {'online' if online else 'offline'}"


# ----------------------------------------------------------------------------
# Network / Wi-Fi helpers
# ----------------------------------------------------------------------------

def is_wireless_enabled() -> bool:
    return read_file("/icpc/WIRELESS_ENABLED", "false").lower() == "true"


def wifi_interfaces():
    if not is_wireless_enabled():
        return []
    interfaces = []
    net_dir = Path("/sys/class/net")
    if net_dir.exists():
        for iface_dir in sorted(net_dir.iterdir()):
            if (iface_dir / "wireless").exists() or (iface_dir / "phy80211").exists():
                interfaces.append(iface_dir.name)
    return interfaces


def check_network() -> bool:
    """Instant, local-only check: does the machine have a default route (i.e. DHCP succeeded)?

    Deliberately makes no HTTP requests or pings: end-to-end reachability of the contest
    sites through Squid is verified (in parallel) by /icpc/scripts/self_test instead.
    """
    for family in ("-4", "-6"):
        res = run_quiet(["ip", family, "route", "show", "default"], timeout=3)
        if res is not None and res.returncode == 0 and res.stdout.strip():
            return True
    return False


def wait_for_network_manager(timeout: int = 15):
    """Event-driven wait (no polling) until NetworkManager finished activating saved connections."""
    if shutil.which("nm-online"):
        run_quiet(["nm-online", "-s", "-q", "-t", str(timeout)], timeout=timeout + 5)


def wifi_scan(interface):
    """Return [(ssid, signal_percent)] sorted by signal strength (strongest first)."""
    run_quiet(["rfkill", "unblock", "wifi"], timeout=5)
    run_quiet(["nmcli", "radio", "wifi", "on"], timeout=5)

    base = ["nmcli", "-t", "--escape", "no", "-f", "SIGNAL,SSID", "dev", "wifi", "list"]
    res = run_quiet(base + ["--rescan", "yes", "ifname", interface], timeout=30)
    if res is None or res.returncode != 0 or not res.stdout.strip():
        # NetworkManager may reject back-to-back rescans or still be initializing; fall back to cached/auto
        time.sleep(1)
        res = run_quiet(base + ["--rescan", "auto", "ifname", interface], timeout=30)

    best = {}
    if res is not None and res.returncode == 0:
        for line in res.stdout.splitlines():
            # SIGNAL comes first so SSIDs containing ':' are still parsed correctly
            sig, _, ssid = line.partition(":")
            ssid = ssid.strip()
            if not ssid:
                continue  # hidden network; use "[Enter Hidden / Custom SSID]"
            try:
                sig_val = int(sig)
            except ValueError:
                sig_val = 0
            best[ssid] = max(sig_val, best.get(ssid, 0))

    return sorted(best.items(), key=lambda kv: kv[1], reverse=True)


def apply_wifi(w: Whiptail, interface, ssid, password, hidden=False):
    infobox(w, f"Connecting to Wi-Fi network '{ssid}'...\n\nThis can take up to 30 seconds.")
    # --wait caps how long nmcli blocks; it returns once the connection (incl. DHCP) is active
    cmd = ["nmcli", "--wait", "30", "dev", "wifi", "connect", ssid, "ifname", interface]
    if password:
        cmd.extend(["password", password])
    if hidden:
        cmd.extend(["hidden", "yes"])

    res = run_quiet(cmd, timeout=40)
    if res is not None and res.returncode == 0:
        return True, ""
    if res is None:
        return False, "Timed out while connecting."
    return False, (res.stderr or res.stdout or "nmcli failed").strip()


def configure_wifi(w: Whiptail):
    interfaces = wifi_interfaces()
    if not interfaces:
        return

    w.title = "ICPC Setup - WiFi Setup"
    if len(interfaces) == 1:
        interface = interfaces[0]
    else:
        choice, code = w.menu(
            msg="Choose the wireless interface to configure Wi-Fi:",
            items=interfaces,
        )
        if code != 0 or not choice:
            return
        interface = choice

    while True:
        infobox(w, f"Scanning for Wi-Fi networks on {interface}...")
        networks = wifi_scan(interface)
        menu_items = [(ssid, f"{sig}%") for ssid, sig in networks]
        menu_items += [
            ("[Enter Hidden / Custom SSID]", "Type the network name manually"),
            ("[Rescan]", "Scan for networks again"),
            ("[Skip Wi-Fi Setup]", "Continue without Wi-Fi"),
        ]

        choice, code = w.menu(
            msg=f"Select a Wi-Fi network on {interface}:",
            items=menu_items,
        )
        if code != 0 or not choice or choice == "[Skip Wi-Fi Setup]":
            return
        if choice == "[Rescan]":
            continue

        hidden = False
        if choice == "[Enter Hidden / Custom SSID]":
            entered_ssid, code = w.inputbox(msg="Enter the Wi-Fi SSID:")
            entered_ssid = entered_ssid.strip()
            if code != 0 or not entered_ssid:
                continue
            ssid = entered_ssid
            hidden = True
        else:
            ssid = choice

        password, code = w.inputbox(
            msg=f"Enter the Wi-Fi password for '{ssid}' (leave empty for an open network):",
            password=True,
        )
        if code != 0:
            continue

        ok, err_msg = apply_wifi(w, interface, ssid, password, hidden=hidden)
        if ok:
            return

        if not w.yesno(
            msg=f"Failed to connect to '{ssid}':\n\n{err_msg}\n\nWould you like to try again?",
            default="yes",
        ):
            return


# ----------------------------------------------------------------------------
# DOMjudge / printing helpers
# ----------------------------------------------------------------------------

def is_domjudge_enabled() -> bool:
    return read_file("/icpc/DOMJUDGE_ENABLED", "false").lower() == "true"


def read_domjudge_credentials():
    creds_path = Path("/icpc/domjudge_credentials")
    if not creds_path.exists():
        return None, None
    try:
        data = json.loads(creds_path.read_text(encoding="utf-8"))
        username = str(data.get("username", "")).strip()
        password = str(data.get("password", ""))
        if username and password:
            return username, password
    except Exception:
        pass
    return None, None


def needs_domjudge_setup() -> bool:
    if not is_domjudge_enabled():
        return False
    url = read_file("/icpc/JUDGE_SYSTEM_URL", "")
    parsed = urlparse(url) if url else None
    if not parsed or parsed.scheme not in ("http", "https") or not parsed.hostname:
        return True
    username, password = read_domjudge_credentials()
    return not (username and password)


def sync_domjudge_config(reload_squid: bool = False):
    cmd = ["/icpc/scripts/domjudge_apply_creds"]
    if reload_squid:
        cmd.append("--reload-squid")
    run_quiet(cmd, timeout=60)


def sync_printing_config():
    script = Path("/icpc/scripts/printing_configure")
    if script.exists():
        run_quiet([str(script)], timeout=60)


def needs_print_team_prompt() -> bool:
    if is_domjudge_enabled():
        return False
    mode = read_file("/icpc/PRINT_MODE", "local").lower()
    if mode not in ("ipp", "cups", "http"):
        return False
    return len(read_file("/icpc/PRINT_TEAM", "")) == 0


def configure_print_team(w: Whiptail, force: bool = False):
    if is_domjudge_enabled():
        return
    mode = read_file("/icpc/PRINT_MODE", "local").lower()
    if mode not in ("ipp", "cups", "http"):
        return
    existing = read_file("/icpc/PRINT_TEAM", "")
    if existing and not force:
        return

    w.title = "ICPC Setup - Team Print Header"
    while True:
        entered, code = w.inputbox(
            msg="Enter the team name to display on printed pages:",
            default=existing,
        )
        if code != 0:
            return
        entered = entered.strip()
        if entered:
            for fname in ("/icpc/PRINT_TEAM", "/icpc/TEAMNAME", "/icpc/TEAM"):
                Path(fname).write_text(entered + "\n", encoding="utf-8")
                os.chmod(fname, 0o644)
            break
        w.msgbox("Team name cannot be empty.")


def configure_domjudge(w: Whiptail, force: bool = False):
    if not is_domjudge_enabled():
        return

    url = read_file("/icpc/JUDGE_SYSTEM_URL", "")
    parsed = urlparse(url) if url else None
    url_valid = bool(parsed and parsed.scheme in ("http", "https") and parsed.hostname)
    existing_user, existing_pass = read_domjudge_credentials()

    # Already configured and synced at the start of main(); nothing to do
    if not force and url_valid and existing_user and existing_pass:
        return

    if force and url_valid and existing_user and existing_pass:
        w.title = "ICPC Setup - DOMjudge Configuration"
        if w.yesno(
            msg=f"DOMjudge credentials are already configured.\n\nURL: {url}\nTeam: {existing_user}\n\nKeep existing DOMjudge settings?",
            default="yes",
        ):
            return

    w.title = "ICPC Setup - DOMjudge Configuration"
    username = existing_user or ""
    prompt_url = (not url_valid) or force
    while True:
        if prompt_url:
            entered_url, code = w.inputbox(
                msg="Enter the DOMjudge server URL (e.g. https://judge.example.com/):",
                default=url,
            )
            if code != 0:
                return
            entered_url = entered_url.strip()
            p = urlparse(entered_url) if entered_url else None
            if not p or p.scheme not in ("http", "https") or not p.hostname:
                w.msgbox("Please enter a valid http:// or https:// DOMjudge URL.")
                continue
            url = entered_url
            url_valid = True

        entered_user, code = w.inputbox(
            msg=f"DOMjudge URL: {url}\n\nEnter the DOMjudge team username:",
            default=username,
        )
        if code != 0:
            return
        entered_user = entered_user.strip()
        if not entered_user:
            w.msgbox("Team username cannot be empty.")
            continue
        username = entered_user

        entered_pass, code = w.inputbox(
            msg=f"Enter the DOMjudge password for team '{username}':",
            password=True,
        )
        if code != 0:
            return
        if not entered_pass:
            w.msgbox("Team password cannot be empty.")
            continue

        if w.yesno(
            msg=f"DOMjudge URL: {url}\nTeam Username: {username}\n\nSave these DOMjudge credentials?",
            default="yes",
        ):
            password = entered_pass
            break

    Path("/icpc/JUDGE_SYSTEM_URL").write_text(url + "\n", encoding="utf-8")
    os.chmod("/icpc/JUDGE_SYSTEM_URL", 0o644)

    creds_path = Path("/icpc/domjudge_credentials")
    creds_path.write_text(
        json.dumps({"username": username, "password": password}) + "\n",
        encoding="utf-8",
    )
    os.chmod(creds_path, 0o600)
    os.chown(creds_path, 0, 0)
    Path("/icpc/PRINT_TEAM").unlink(missing_ok=True)

    infobox(w, "Saving DOMjudge settings and reloading the proxy...")
    sync_domjudge_config(reload_squid=True)


def welcome(w: Whiptail):
    w.title = "ICPC Setup - Welcome"
    code = w.msgbox(
        "Please answer the following questions to finalize the configuration of your environment.\n\nYou can re-run this script later by executing '/icpc/scripts/icpc_setup -f' as root."
    )
    return code == 0


# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------

def activate_attached_vt():
    """If running on a dedicated virtual console (e.g. /dev/tty8 from firstboot.service), switch to it."""
    try:
        tty = os.ttyname(0)
    except OSError:
        return
    if tty.startswith("/dev/tty") and tty[8:].isdigit():
        run_quiet(["chvt", tty[8:]], timeout=3)


def main():
    if os.geteuid() != 0:
        print("Error: This script must be run as root!")
        sys.exit(1)

    force = len(sys.argv) > 1 and sys.argv[1] in ("-f", "--force")

    # Keep DOMjudge and printing configuration synced if already present
    if not needs_domjudge_setup():
        sync_domjudge_config(reload_squid=True)
    sync_printing_config()

    # Exit if the configuration has already been run and the force argument was not specified
    if Path("/icpc/setup-complete").exists() and not force and not needs_domjudge_setup() and not needs_print_team_prompt():
        print("Already configured. Run with -f or --force to reconfigure.")
        sys.exit(0)

    activate_attached_vt()

    w = Whiptail(title="ICPC Setup")
    has_wifi = len(wifi_interfaces()) > 0  # always False when wireless is disabled

    network_status = check_network()
    if has_wifi and not network_status:
        set_network_backtitle(w, network_status)
        infobox(w, "Waiting for the network connection (up to 15 seconds)...")
        wait_for_network_manager(15)
        network_status = check_network()
    set_network_backtitle(w, network_status)

    # Only show the welcome screen when there is actually something to ask
    if force or needs_domjudge_setup() or needs_print_team_prompt() or (has_wifi and not network_status):
        welcome(w)

    # Prompt to configure Wi-Fi when wireless support is enabled and either no active
    # network connection is present (or the admin ran icpc_setup -f).
    if has_wifi:
        network_status = check_network()  # DHCP may have finished while the welcome screen was shown
        set_network_backtitle(w, network_status)
        if not network_status:
            if w.yesno(
                msg="No active network connection was detected.\n\nWould you like to connect to a Wi-Fi network now?",
                default="yes",
            ):
                configure_wifi(w)
        elif force:
            if w.yesno(
                msg="An active network connection is already present.\n\nWould you like to configure or switch Wi-Fi networks?",
                default="no",
            ):
                configure_wifi(w)
        set_network_backtitle(w, check_network())

    configure_domjudge(w, force=force)
    configure_print_team(w, force=force)

    # Clear the screen
    print(chr(27) + "[H" + chr(27) + "[J")
    print("Running self test, please wait...\n", flush=True)

    # Run the self-test script
    p = Popen("su - -c /icpc/scripts/self_test | tee /icpc/self_test_report", shell=True, stderr=PIPE)
    p.communicate()

    # Remove the self-test report
    Path("/icpc/self_test_report").unlink(missing_ok=True)

    input("Press [enter] to continue")
    Path("/icpc/setup-complete").write_text("configured\n", encoding="utf-8")


if __name__ == "__main__":
    main()
