# 4MB is the default, so we could omit that...
# dynamic_cert_mem_cache_size=4MB
# Bind Squid only to loopback (IPv4 + IPv6) so it is never exposed on LAN interfaces
http_port 127.0.0.1:3128 ssl-bump generate-host-certificates=on tls-cert=/etc/squid/squidCA.crt tls-key=/etc/squid/squidCA.pem
http_port [::1]:3128 ssl-bump generate-host-certificates=on tls-cert=/etc/squid/squidCA.crt tls-key=/etc/squid/squidCA.pem

# need to manually initialized the ssl_db
#sudo /usr/lib/squid/security_file_certgen -c -s /var/spool/squid/ssl_db -M 4MB

{% set extra_safe_ports = [] -%}
{% set extra_ssl_ports = [] -%}
{% for raw_url in [judge_system_url | default(''), print_server_url | default('')] -%}
{% set u = raw_url | trim -%}
{% if u and '://' in u -%}
{% set p = u | urlsplit('port') -%}
{% set s = (u | urlsplit('scheme') | default('', true)) | lower -%}
{% if p and (p | int) not in [80, 443, 8000, 8050, 8080, 8443] and (p | int) not in extra_safe_ports -%}
{% set _ = extra_safe_ports.append(p | int) -%}
{% endif -%}
{% if p and s == 'https' and (p | int) not in [443, 8443] and (p | int) not in extra_ssl_ports -%}
{% set _ = extra_ssl_ports.append(p | int) -%}
{% endif -%}
{% endif -%}
{% endfor -%}
acl SSL_ports port 443 8443{{ (' ' ~ (extra_ssl_ports | join(' '))) if extra_ssl_ports | length > 0 else '' }}
acl Safe_ports port 80          # http
acl Safe_ports port 443         # https
acl Safe_ports port 8000        # common local judge/print HTTP port
acl Safe_ports port 8050        # contest server (e.g. grcpc.gr)
acl Safe_ports port 8080        # common local judge/print HTTP port
acl Safe_ports port 8443        # common local judge/print HTTPS port
{% for p in extra_safe_ports %}
acl Safe_ports port {{ p }}        # configured judge/print server port
{% endfor %}
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# Deny access to the cachemgr
http_access deny manager

# ===== ALLOWED DOMAINS =====
acl allowed_domains dstdomain "/etc/squid/acl_allowed_domains.txt"
# Allow local offline docs served by nginx on localhost without using a DNS-resolving
# `dst 127.0.0.1` ACL (a `dst` ACL forces DNS lookups for every blocked domain and can
# be bypassed by external domains returning both 127.0.0.1 and a public IP).
acl local_docs_host dstdomain localhost 127.0.0.1
acl local_docs_port port 80 443

# Keep live cppreference.com documentation read-only (allow browsing/searching,
# block wiki edits, uploads, and account login/creation).
acl cppref_domain dstdomain .cppreference.com
acl cppref_write_method method POST PUT DELETE PATCH
acl cppref_write_url url_regex -i ([?&]action=(edit|submit|delete|protect|move|rollback)|/Special:(UserLogin|CreateAccount|Preferences|Upload))
http_access deny cppref_domain cppref_write_method
http_access deny cppref_domain cppref_write_url

# Allow whitelisted domains
http_access allow allowed_domains
# Allow local nginx docs on localhost/127.0.0.1 (ports 80/443 only)
http_access allow local_docs_host local_docs_port

# Block everything else
http_access deny all

# show a block page
deny_info ICPC_ERR_ACCESS_DENIED all

# ===== DOMJUDGE AUTOLOGIN & API AUTH =====
# Define an always-present (never-matching) default so !domjudge_api below is valid
# even when /etc/squid/autologin.conf is a placeholder or DOMjudge is disabled.
acl domjudge_api url_regex ^$
{% for url in (squid_autologin_urls | default([])) %}
acl autologin url_regex {{ url }}
{% endfor %}
include /etc/squid/autologin.conf

# ===== CONTEST SERVER AUTH =====
# Inject the auth token (replaces the old tinyproxy AddHeader in playbooks/proxy.yaml).
# Only sent to auth_token_domains so the token is not leaked to other whitelisted sites,
# and skipped on domjudge_api where Squid injects HTTP Basic auth for the submit CLI.
# Works for https as well, since everything is ssl-bumped below.
{% if auth_token is defined and auth_token and (auth_token_domains | default([])) | length > 0 %}
{% for domain in auth_token_domains %}
acl contest_server dstdomain .{{ domain }}
{% endfor %}
acl has_auth_header req_header Authorization .+
request_header_add Authorization "Bearer {{ auth_token }}" contest_server !has_auth_header !domjudge_api
{% endif %}

coredump_dir /var/spool/squid

# To make it quick to restart squid, otherwise it takes ~30s to stop
shutdown_lifetime 1 second

# MITM everything!
ssl_bump bump all

# Ignore ssl errors, so we can still show our nice block page
# And also because our block page has no good ssl certificate
sslproxy_cert_error allow all
