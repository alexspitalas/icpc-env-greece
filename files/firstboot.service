[Unit]
Description=Initial configuration of the image
Before=lightdm.service
After=cups.service systemd-user-sessions.service
Conflicts=getty@tty8.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=0
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
TTYPath=/dev/tty8
StandardInput=tty
StandardOutput=tty
ExecStart=/icpc/scripts/icpc_setup

[Install]
WantedBy=graphical.target
WantedBy=multi-user.target
